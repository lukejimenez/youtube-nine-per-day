{
  "manifest_version": 3,
  "name": "YouTube Ten a Day",
  "version": "0.1.0",
  "description": "Freezes your YouTube home feed to 10 recommended videos per day. No infinite scroll.",
  "permissions": ["storage"],
  "browser_specific_settings": {
    "gecko": { "id": "yt-ten-a-day@local" }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css", "distractions.css", "search.css", "subscriptions.css"],
      "run_at": "document_start"
    }
  ]
}
